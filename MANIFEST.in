include LICENSE THIRD_PARTY_NOTICES.md PACKAGE_README.md README.md CHANGELOG.md CONTRIBUTING.md requirements.txt
recursive-include src *.py
recursive-include tests *.py
recursive-include docs *.md
recursive-include scripts *.py
prune data
prune models
prune runs
prune web
prune reports
prune .site-deploy
global-exclude *.py[cod] __pycache__ *.mp4 *.mov *.avi *.npz *.npy *.pt *.joblib *.task .env .env.*
